# Environment Configuration for SovereignID

# Pinata API (IPFS for DID document hosting)
VITE_PINATA_API_KEY=your_pinata_api_key
VITE_PINATA_JWT=your_pinata_jwt

# Circle API (USDC wallet integration)
VITE_CIRCLE_API_KEY=your_circle_api_key
VITE_CIRCLE_ENTITY_SECRET=your_circle_entity_secret

# Bitcoin Network (for ion-tools DID anchoring)
# Options: testnet, mainnet
VITE_BITCOIN_NETWORK=testnet

# Optional: Backend API endpoint for credential issuance
VITE_ISSUER_API_BASE=https://api.example.com

# Application environment
VITE_ENV=development
# Options: development, staging, production

# Enable debug logging in service worker
VITE_DEBUG_SW=true

# Enable mock data for testing (no API calls)
VITE_MOCK_MODE=false
