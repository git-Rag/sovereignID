# SovereignID v2 — Environment Variables (Solana + Arweave)

# Solana Configuration
# Devnet for hackathon/testing — free devnet tokens available in seconds
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC=https://api.devnet.solana.com

# Arweave Configuration
# Testnet for hackathon/testing — free storage
VITE_ARWEAVE_HOST=arweave.net
VITE_ARWEAVE_ENV=testnet

# USDC on Solana Devnet
# Devnet USDC mint address — used for balance queries and transfers
VITE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Optional: Arweave wallet key (for production)
# For hackathon, the app generates ephemeral Arweave wallets
# ARWEAVE_WALLET_KEY=

# Optional: Solana fee payer keypair (for production)
# For hackathon, the app uses devnet airdrops; production needs a funded relayer
# SOLANA_KEYPAIR=

# Application environment
VITE_ENV=development
# Options: development, staging, production

# Enable debug logging
VITE_DEBUG=true
